{
  "id": null,
  "uid": "sis2-service",
  "title": "SIS2 \u2014 Image Service",
  "tags": [
    "sis2"
  ],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Service scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sis2-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"sis2\"}",
          "legendFormat": "API"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "boolean",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Completed server attempts / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sis2-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol) (rate(sis2_requests_total[1m]))",
          "legendFormat": "{{protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Server errors (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sis2-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (protocol) (rate(sis2_requests_total{outcome=\"error\"}[1m])) or on (protocol) (0 * sum by (protocol) (rate(sis2_requests_total[1m])))) / clamp_min(sum by (protocol) (rate(sis2_requests_total[1m])), 0.000001)",
          "legendFormat": "{{protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Server attempt p95 (not client logical-call latency)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sis2-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, protocol) (rate(sis2_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Attempts / second by operation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sis2-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, operation) (rate(sis2_requests_total[1m]))",
          "legendFormat": "{{protocol}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Go heap allocated",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sis2-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_alloc_bytes",
          "legendFormat": "Go heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Process CPU (100% = one core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sis2-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(process_cpu_seconds_total[1m])",
          "legendFormat": "CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Completed attempts since process start",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sis2-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, outcome) (sis2_requests_total)",
          "legendFormat": "{{protocol}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "editable": true
}
